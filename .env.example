# Copy to .env and adjust. Used by docker-compose.yml.
# PUBLIC_HOST: the name people type in the browser; your reverse proxy serves
# HTTPS for it (docs/operations.md §4).
PUBLIC_HOST=notes.example.com
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=coolpsonotes
OIDC_CLIENT_SECRET=change-me
# Optional: comma separated "issuer|subject" identities that are administrators.
# By default the first person to sign in becomes administrator.
ADMINS=
# Optional: bearer token for Prometheus scraping /metrics. Don't let your proxy
# serve /metrics publicly; set this too if something else on your network can
# reach the server and shouldn't read it.
METRICS_TOKEN=
# Only with the Caddy example (deploy/examples/caddy) on a home network:
# CADDYFILE=deploy/examples/caddy/Caddyfile.lan
