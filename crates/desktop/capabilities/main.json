{
  "identifier": "main",
  "description": "What the app's own window may ask of the app (docs/desktop.md): its commands, nothing of Tauri's or its plugins'.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-desktop-info",
    "allow-add-server",
    "allow-switch-account",
    "allow-remove-account",
    "allow-account-seen",
    "allow-use-this-computer",
    "allow-local-start",
    "allow-local-session",
    "allow-sign-in",
    "allow-cancel-sign-in",
    "allow-set-close-to-tray",
    "allow-set-autostart",
    "allow-open-external",
    "allow-choose-folder",
    "allow-folder-start",
    "allow-folder-off",
    "allow-folder-retry",
    "allow-reveal-folder",
    "allow-session-changed",
    "allow-signed-out",
    "allow-forget-computer",
    "allow-folder-bring",
    "allow-cli-folders",
    "allow-folder-take-from-cli",
    "allow-cancel-take",
    "allow-setup-done",
    "allow-dismiss-update",
    "allow-update-help",
    "allow-next-event"
  ]
}
