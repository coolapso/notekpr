# Copy to .env and adjust. Used by docker-compose.yml.
# PUBLIC_HOST: the name people type in the browser. With the default Caddyfile
# it needs public DNS and ports 80/443 reachable for automatic certificates;
# on a home network use CADDYFILE=deploy/Caddyfile.lan instead.
PUBLIC_HOST=notes.example.com
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=coolpsonotes
OIDC_CLIENT_SECRET=change-me
# Optional: comma separated "issuer|subject" identities that are administrators.
# By default the first person to sign in becomes administrator.
ADMINS=
# Optional: bearer token for Prometheus scraping /metrics. Caddy never serves
# /metrics publicly; set this if something else on your network can reach the
# server and shouldn't read it.
METRICS_TOKEN=
# CADDYFILE=deploy/Caddyfile.lan
